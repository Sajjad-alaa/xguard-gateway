#!/bin/sh

# PROVIDE: xguard-gateway
# REQUIRE: NETWORKING wireguard
# KEYWORD: shutdown

. /etc/rc.subr

name="xguard_gateway"
rcvar=xguard_gateway_enable
command="/usr/local/bin/xguard-gateway"
config="/etc/xguard/gateway.toml"
start_cmd="${name}_start"

xguard_gateway_start() {
	${command} --config ${config} &
}

load_rc_config $name
run_rc_command "$1"
